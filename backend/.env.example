# Copy values into your process environment (PowerShell shown below).
# The application does NOT automatically load .env files.
# Placeholders only — never put real credentials in this file or commit secrets.

# =============================================================================
# Development (PostgreSQL only — no SQLite fallback)
# =============================================================================
APP_ENV=development
# ENVIRONMENT is an accepted alias for APP_ENV.

# JWT signing secret.
# Development: optional (insecure local default used when unset).
# Production: REQUIRED — long random value; placeholders like "changeme" are rejected.
SECRET_KEY=replace-with-a-strong-random-secret

# Comma-separated frontend origins (scheme + host + optional port). No paths. No "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# REQUIRED — PostgreSQL URL for local app development (database name: houseprice_dev).
# Prefer the psycopg v3 SQLAlchemy dialect:
#   postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/houseprice_dev
DATABASE_URL=postgresql+psycopg://houseprice_app:YOUR_PASSWORD@127.0.0.1:5432/houseprice_dev

# REQUIRED for automated tests — must point at houseprice_test only.
# Tests reject houseprice_dev, houseprice_prod, SQLite, and missing values.
# Never use the production database URL here.
TEST_DATABASE_URL=postgresql+psycopg://houseprice_app:YOUR_PASSWORD@127.0.0.1:5432/houseprice_test

# Production process (python -m run_production)
# PORT=8001
# WEB_CONCURRENCY=1

# Password-reset link base
FRONTEND_BASE_URL=http://localhost:3000

# Optional
# PASSWORD_RESET_EXPIRE_MINUTES=30
# PASSWORD_RESET_DEV_RETURN_TOKEN=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
# DATASET_PATH=data/house_data.csv

# =============================================================================
# PowerShell — local development (do not commit real passwords)
# =============================================================================
# cd backend
# .\.venv\Scripts\Activate.ps1
# $env:APP_ENV="development"
# $env:DATABASE_URL="postgresql+psycopg://houseprice_app:YOUR_PASSWORD@127.0.0.1:5432/houseprice_dev"
# uvicorn main:app --reload --port 8001
#
# PowerShell — run tests against houseprice_test only:
# $env:TEST_DATABASE_URL="postgresql+psycopg://houseprice_app:YOUR_PASSWORD@127.0.0.1:5432/houseprice_test"
# pytest -q
#
# Optional (gitignored): put the same URL alone in backend/.local/test_database_url
# so pytest can read it without setting the process env var. Never commit that file.
#
# Production checklist (host env — placeholders only):
# APP_ENV=production
# SECRET_KEY=<long-random-secret>
# CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@PROD_HOST:5432/houseprice_prod
# FRONTEND_BASE_URL=https://your-frontend.example
# python -m run_production
