# Public frontend config. Values are embedded into the JS bundle at build time.
# This is NOT a secret. Placeholders / local defaults only — never invent a live domain.

# =============================================================================
# Development
# =============================================================================
# Local API origin used by Axios (scheme + host + optional port).
VITE_API_URL=http://127.0.0.1:8001

# =============================================================================
# Production deploy build
# =============================================================================
# 1) Set the real backend API origin (not localhost / 127.0.0.1 / 0.0.0.0):
# VITE_API_URL=https://api.example.com
#
# 2) Mark the process as a production deploy so Vite rejects loopback API URLs:
# APP_ENV=production
# (ENVIRONMENT=production and VITE_APP_ENV=production are also accepted)
#
# Example (PowerShell) before `npm run build`:
#   $env:VITE_API_URL="https://api.example.com"
#   $env:APP_ENV="production"
#   npm run build
#
# Notes:
# - `vite build` always requires VITE_API_URL (no empty bake-in).
# - With APP_ENV=production, loopback hosts are rejected at build time.
# - Rebuild the frontend whenever the API origin changes.
