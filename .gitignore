*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

